# gate-service
PORT=5012

# Must match auth-service so the officer's existing access token is accepted.
JWT_SECRET=

# Shared machine key for the hardware event route (same value other services use).
SERVICE_AUTH_KEY=

# Postgres (same hep_automation database as the other services)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=hep_automation
