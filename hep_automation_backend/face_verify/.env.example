PORT=5013

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=hep_automation

JWT_SECRET=your_jwt_secret_here

# URL opened by applicant on their phone/tablet
CAPTURE_BASE_URL=http://localhost:3000

# Optional: Path to raw face images folder for live folder watching and auto-sync
# Note: The system already bundles pre-indexed vector embeddings in models/gallery_index_auraface.json.
# If this directory is omitted or does not exist on your machine, the face verification
# service runs normally in pre-indexed mode without requiring any image folder.
FACE_GALLERY_DIR=/path/to/your/face_images_folder
