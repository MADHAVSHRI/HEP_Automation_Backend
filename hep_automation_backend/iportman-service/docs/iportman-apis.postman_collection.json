              "raw": "{\n  \"Portcode\": \"{{portCode}}\",\n  \"VehicleRegdNo\": \"WB29C1898\",\n  \"VehiclePassReferenceNo\": \"59VLD3004263701\",\n  \"VehiclePassValidTo\": \"2026-05-06 16:38:53\",\n  \"TruckStatus\": \"Loaded\",\n  \"IsContainer\": \"Y\",\n  \"GateNo\": \"Flyover Gate\",\n  \"GateOutDT\": \"2026-05-02 18:30:00\"\n}",
