    {
      "name": "2. iPortman direct (third-party)",
      "description": "The vendor's own endpoints, for checking their behaviour independently of our service.\n\n**Turn SSL certificate verification OFF** (Settings > General) \u2014 the host is addressed by IP, so its certificate cannot match a hostname.\n\nEach endpoint has its own Gravitee key; they are not interchangeable.",
      "item": [
        {
          "name": "Port Entry Permit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Gravitee-Api-Key",
                "value": "{{portEntryPermitApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{iportmanBaseUrl}}/iportman/portentrypermit",
              "host": [
                "{{iportmanBaseUrl}}"
              ],
              "path": [
                "iportman",
                "portentrypermit"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"PortEntryPermit\": {\n    \"AgentType\": \"TRA\",\n    \"AgentCode\": \"1902650\",\n    \"AgentName\": \"PEOPLES TRANSPORT\",\n    \"Passfor\": \"Both\",\n    \"PurposeofPass\": \"Transportation of goods/empty containers \",\n    \"PassIssueDT\": \"2023-08-19 16:48:05\",\n    \"PassReferenceNo\": \"1908231331\",\n    \"Portcode\": \"{{portCode}}\"\n  },\n  \"PersonDetails\": [\n    {\n      \"PersonPassType\": \"Driver\",\n      \"PersonName\": \"ARUL N\",\n      \"PersonLicenseNo\": \"TN5119950000235\",\n      \"PersonLicenseValidity\": \"1900-01-01 00:00:00\",\n      \"PersonIDType\": \"AADHAR CARD\",\n      \"PersonIDNo\": \"441580634051\",\n      \"PassType\": \"Daily\",\n      \"PersonPassValidFrom\": \"2023-08-19 16:56:00\",\n      \"PersonPassValidTo\": \"2023-08-20 05:59:00\"\n    }\n  ],\n  \"VehicleDetails\": [\n    {\n      \"VehicleRegdNo\": \"TN51B2858\",\n      \"VehicleType\": \"Trailors\",\n      \"VehicleInsuranceValidity\": \"19-12-2023\",\n      \"PassType\": \"Daily\",\n      \"PassValidFrom\": \"2023-08-19 16:56:00\",\n      \"PassValidTo\": \"2023-08-20 05:59:00\",\n      \"ContactNo\": \"9940255169\",\n      \"ContactPerson\": \"\",\n      \"RFIDCardNo\": \"\",\n      \"QRCode\": \"10047079\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
