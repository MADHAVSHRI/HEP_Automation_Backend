                "type": "text"
              },
              {
                "key": "x-service-name",
                "value": "POSTMAN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{apacsBaseUrl}}/api/iportman/truck-gate-in/preview",
              "host": [
                "{{apacsBaseUrl}}"
              ],
              "path": [
                "api",
                "iportman",
                "truck-gate-in",
                "preview"
              ]
            },
            "description": "Shapes the document without sending it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"VehicleRegdNo\": \"WB29C1898\",\n  \"VehiclePassReferenceNo\": \"59VLD3004263701\",\n  \"VehiclePassValidTo\": \"2026-05-06 16:38:53\",\n  \"TruckStatus\": \"Empty\",\n  \"IsContainer\": \"Y\",\n  \"GateNo\": \"Phosphate Gate\",\n  \"GateInDT\": \"2026-05-05 16:42:30\"\n}",
