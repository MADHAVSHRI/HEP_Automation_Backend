{
  "info": {
    "_postman_id": "e5efce57-8d3c-45d0-8a9b-73142af5a5a1",
    "name": "APACS - iPortman Integrations",
    "description": "The three iPortman integrations: Port Entry Permit, Truck Gate-In and Truck Gate-Out.\n\nFolder 1 hits our own iportman-service. Folder 2 hits the vendor directly.\n\nImport `iportman-local.postman_environment.json` alongside this and select it \u2014 the keys live there, not in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. APACS iportman-service (our endpoints)",
      "description": "Endpoints this deployment exposes. Guarded by `x-service-key`, which must match SERVICE_AUTH_KEY in iportman-service/.env.\n\nThe `/preview` requests build the document and return it **without** sending it to iPortman \u2014 use them to check the field mapping first.",
      "item": [
        {
          "name": "Port Entry Permit - push",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-service-key",
                "value": "{{serviceAuthKey}}",
                "type": "text"
              },
              {
                "key": "x-service-name",
                "value": "POSTMAN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{apacsBaseUrl}}/api/iportman/port-entry-permit",
              "host": [
                "{{apacsBaseUrl}}"
              ],
              "path": [
                "api",
                "iportman",
                "port-entry-permit"
              ]
            },
            "description": "Builds the permit from the database for this pass request and pushes it. Fired automatically by user_service when a pass reaches COMPLETED; this is the manual equivalent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passRequestId\": \"{{passRequestId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Port Entry Permit - preview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-service-key",
                "value": "{{serviceAuthKey}}",
                "type": "text"
              },
              {
                "key": "x-service-name",
                "value": "POSTMAN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{apacsBaseUrl}}/api/iportman/port-entry-permit/{{passRequestId}}/preview",
              "host": [
                "{{apacsBaseUrl}}"
              ],
              "path": [
                "api",
                "iportman",
                "port-entry-permit",
                "{{passRequestId}}",
                "preview"
              ]
            },
            "description": "Returns the exact document that would be sent. Nothing leaves the network."
          },
          "response": []
        },
        {
          "name": "Truck Gate-In - push",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-service-key",
                "value": "{{serviceAuthKey}}",
                "type": "text"
              },
              {
                "key": "x-service-name",
                "value": "POSTMAN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{apacsBaseUrl}}/api/iportman/truck-gate-in",
              "host": [
                "{{apacsBaseUrl}}"
              ],
              "path": [
                "api",
                "iportman",
                "truck-gate-in"
              ]
            },
            "description": "Portcode defaults to INMAA1 when omitted. GateInDT defaults to now.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"VehicleRegdNo\": \"WB29C1898\",\n  \"VehiclePassReferenceNo\": \"59VLD3004263701\",\n  \"VehiclePassValidTo\": \"2026-05-06 16:38:53\",\n  \"TruckStatus\": \"Empty\",\n  \"IsContainer\": \"Y\",\n  \"GateNo\": \"Phosphate Gate\",\n  \"GateInDT\": \"2026-05-05 16:42:30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Truck Gate-In - preview",
          "request": {
            "method": "POST",
            "header": [
